{
    "version": "0.2.0",
    "compounds": [
        {
            "name": "Run Extension + Server",
            "configurations": [
                "Launch Extension",
                "Attach Language Server"
            ],
            "stopAll": true
        }
    ],
    "configurations": [
        {
            "name": "Launch Extension",
            "type": "extensionHost",
            "request": "launch",
            "env": {
                "NODE_OPTIONS": "--inspect=6009"
            },
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}",
                "--disable-extensions",
                "--user-data-dir=${workspaceFolder}/.vscode-dev-userdata"
            ],
            "outFiles": [
                "${workspaceFolder}/out/**/*.js"
            ],
            "preLaunchTask": "npm: watch"
        },
        {
            "name": "Attach Language Server",
            "type": "node",
            "request": "attach",
            "port": 6010,
            "restart": true,
            "timeout": 30000,
            "skipFiles": [
                "<node_internals>/**"
            ],
            "outFiles": [
                "${workspaceFolder}/out/**/*.js"
            ]
        },
        {
            "name": "Debug Language Server (standalone)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "node",
            "runtimeArgs": [
                "--inspect=6010"
            ],
            "program": "${workspaceFolder}/out/packages/language-server/src/server.js",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "outFiles": [
                "${workspaceFolder}/out/**/*.js"
            ],
            "preLaunchTask": "npm: watch"
        },
        {
            "name": "Debug Tests (npm test)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "test"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "preLaunchTask": "${defaultBuildTask}"
        }
    ]
}